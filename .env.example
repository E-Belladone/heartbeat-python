# Two Postgres DSNs, one per least-privilege role (see deploy/db/roles.sql).
# Generate role passwords with `openssl rand -hex 24`. These are secrets.

# poller: the only writer of presence data
HEARTBEAT_POLLER_DSN=postgres://heartbeat_poller:CHANGE-ME@localhost:5432/heartbeat?sslmode=disable
HEARTBEAT_POLLER_POLL_INTERVAL=60
HEARTBEAT_POLLER_DEBOUNCE=120

# proxy: public-facing, reads aggregates only
HEARTBEAT_PROXY_DSN=postgres://heartbeat_proxy:CHANGE-ME@localhost:5432/heartbeat?sslmode=disable
HEARTBEAT_PROXY_HOST=127.0.0.1
HEARTBEAT_PROXY_PORT=8100

# ingest: the only writer of signal events (tailnet-only, never public)
HEARTBEAT_INGEST_DSN=postgres://heartbeat_ingest:CHANGE-ME@localhost:5432/heartbeat?sslmode=disable
HEARTBEAT_INGEST_HOST=127.0.0.1
HEARTBEAT_INGEST_PORT=8102
